# URL del backend
VITE_API_URL=http://localhost:3000

# Formato de paginación del backend: dotnet, dotnet-page, node u offset
VITE_PAGINATION=dotnet

# Inicio de sesión con Google y Microsoft: URL del backend que arranca cada OAuth.
# Vacías = los botones solo avisan que falta conectarlos.
VITE_OAUTH_GOOGLE_URL=
VITE_OAUTH_MICROSOFT_URL=
